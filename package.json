{
  "name": "@yyfather/dsh-token-vault",
  "version": "1.0.4",
  "description": "Credential vault for DeepSeek Harness: four-field credentials (name / type / credential fields / remark), preset types incl. API key, token, username-password, database, SMTP and SSH key, Chinese names, and gh/npm/npx/node/git/curl execution with %TOKEN% substitution — secrets never leave the host.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYfather/dsh-token-vault.git"
  },
  "homepage": "https://github.com/YYfather/dsh-token-vault#readme",
  "bugs": {
    "url": "https://github.com/YYfather/dsh-token-vault/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "credentials",
    "vault",
    "secrets",
    "tokens",
    "security"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
